{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asdevi-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-28",
  "build": {
    "command": "npm run build:cloudflare"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
