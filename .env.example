# URL pública del sitio (sin barra final). Se usa en canonicals, sitemap y JSON-LD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Sanity.io — Déjalos vacíos para usar los datos de prueba (fallback mocks).
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2025-02-19"

# Secreto criptográfico compartido con el Webhook de Sanity para POST /api/revalidate
# Genera uno con: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=""
